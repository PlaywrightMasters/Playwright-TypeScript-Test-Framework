{
  "name": "playwright-typescript-test-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript automation framework for UI, API, mobile, accessibility, visual and database testing",
  "license": "MIT",
  "author": "PlaywrightMasters (adapted from Akshay Pai's MIT-licensed framework)",
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PlaywrightMasters/Playwright-TypeScript-Test-Framework.git"
  },
  "scripts": {
    "demo": "node scripts/demo-server.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint",
    "test": "playwright test --project=Chromium --project=API --project=Helpers",
    "test:all": "playwright test --project=Chromium --project=Firefox --project=WebKit --project=Device --project=API --project=Helpers",
    "test:single": "playwright test --project=Chromium",
    "test:parallel": "playwright test --project=Chromium --workers=4",
    "test:serial": "playwright test --project=Chromium --workers=1",
    "test:serial:ci": "playwright test --project=Chromium --workers=1",
    "test:smoke": "playwright test --project=Chromium --grep @Smoke",
    "test:shard": "playwright test --project=Chromium --project=API --project=Helpers --reporter=blob",
    "test:merge:reports": "playwright merge-reports --reporter=html ./all-blob-reports",
    "test:ui": "playwright test --project=Chromium --ui",
    "test:debug": "playwright test --project=Chromium --debug",
    "test:api": "playwright test --project=API",
    "test:db": "playwright test --project=DB",
    "test:record": "playwright codegen",
    "test:visual": "playwright test --project=Visual",
    "test:visual:update": "playwright test --project=Visual --update-snapshots",
    "test:device": "playwright test --project=Device",
    "test:accessibility": "playwright test tests/accessibility --project=Chromium",
    "test:helpers": "playwright test --project=Helpers",
    "report": "playwright show-report",
    "allureReport": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "lighthouse": "node tests/lighthouse/Lighthouse.js",
    "report:zip": "node scripts/archive-report.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "allure-commandline": "2.46.1",
    "allure-playwright": "3.15.0",
    "chrome-launcher": "1.2.3",
    "eslint": "9.39.4",
    "exceljs": "4.4.0",
    "lighthouse": "13.6.0",
    "ortoni-report": "4.10.0",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "typescript": "6.0.3",
    "winston": "3.19.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    },
    "tar": "7.5.23",
    "@tootallnate/once": "2.0.1"
  },
  "allowScripts": {
    "sqlite3@5.1.7": true
  }
}
