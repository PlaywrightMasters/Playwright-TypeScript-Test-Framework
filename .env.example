# Local examples work without credentials. Copy to .env to customize.
ENV=local
# ENV=qa uses DemoQA and ReqRes; ENV=dev requires BASE_URL and API_BASE_URL.
# BASE_URL=https://demoqa.com
# API_BASE_URL=https://reqres.in
# TEST_USERNAME=
# TEST_PASSWORD=
# REQRES_API_KEY=
# DATABASE_URL=postgresql://user:password@localhost:5432/test_database
# DEMO_PORT=4173
# ORTONI=1
# LIGHTHOUSE_URL=https://your-test-site.example
# SONAR_HOST_URL=
# SONAR_TOKEN=
